class Mcp:
    def __init__(self):
        env = {k: v for k, v in os.environ.items() if not k.startswith("ZERON_CHAT")}
        self.p = subprocess.Popen([zeron_exe(), "mcp"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                  stderr=subprocess.DEVNULL, text=True, env=env)
        self.n = 0
        self.rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                                "clientInfo": {"name": "heronctl", "version": "1"}})
        self.p.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n")
        self.p.stdin.flush()
    def rpc(self, method, params):
        self.n += 1
        self.p.stdin.write(json.dumps({"jsonrpc": "2.0", "id": self.n, "method": method, "params": params}) + "\n")
        self.p.stdin.flush()
        while True:
            line = self.p.stdout.readline()
            if not line:
                raise RuntimeError("zeron mcp closed (is Zeron running here?)")
            msg = json.loads(line)
            if msg.get("id") == self.n:
                if "error" in msg:
                    raise RuntimeError(json.dumps(msg["error"]))
                return msg["result"]
    def tool(self, name, args=None):
        res = self.rpc("tools/call", {"name": name, "arguments": args or {}})
        text = "".join(c.get("text", "") for c in res.get("content", []) if c.get("type") == "text")
        if res.get("isError"):
            raise RuntimeError(text)
        return json.loads(text)

def find_chat(mcp, title, archived=False):
    chats = mcp.tool("list_chats", {"limit": 500, "include_archived": archived})["chats"]
    mine = [c for c in chats if not c.get("parentChatId") and c.get("title") == title
            and (c.get("cwd") or "") in ("~/heron", "~/heron/")]
    mine.sort(key=lambda c: (bool(c.get("archived")), c.get("createdAt") or ""))
    return mine[0] if mine else None

def chat(action, title, text=None, wait=0, limit=6, create=False):
    mcp = Mcp()
    try:
        devices = mcp.tool("list_devices")["devices"]
        names = {d["id"]: d["name"] for d in devices}
        me = next(d for d in devices if d.get("local"))
        c = find_chat(mcp, title)
        if action == "where":
            now = datetime.datetime.now(datetime.timezone.utc)
            age = lambda d: int((now - datetime.datetime.fromisoformat(d["lastSeenAt"].replace("Z", "+00:00"))).total_seconds()) if d.get("lastSeenAt") else None
            return {"chat": c and {k: c.get(k) for k in ("id", "model", "sessionStatus", "lastMessageAt", "lastMessagePreview")},
                    "host": c and names.get(c["deviceId"], c["deviceId"]),
                    "devices": [{"name": d["name"], "seen_secs_ago": age(d), "version": d.get("version"), "local": d.get("local")} for d in devices]}
        if action == "cleanup":
            if c:
                mcp.tool("archive_chat", {"chat": c["id"], "archived": True})
            return {"archived": c and c["id"]}
        if not c and create:
            made = mcp.tool("create_chat", {"kind": "chat", "device": me["id"], "harness": "pi", "cwd": "~/heron", "title": title})
            c = {"id": made["chatId"], "deviceId": me["id"]}
        if not c:
            raise RuntimeError("no chat titled %r" % title)
        out = {"chat": c["id"], "host": names.get(c["deviceId"], c["deviceId"])}
        if action == "send":
            t0 = time.time()
            args = {"chat": c["id"], "text": text, "wait": bool(wait)}
            if wait:
                args["timeout_secs"] = int(wait)
            out["sent"] = mcp.tool("send_message", args)
            out["secs"] = round(time.time() - t0, 1)
            limit = 2
        msgs = mcp.tool("read_chat", {"chat": c["id"], "limit": limit}).get("messages", [])
        out["messages"] = [{k: m.get(k) for k in ("role", "createdAtIso", "status", "text", "errors", "tools") if m.get(k)} for m in msgs]
        return out
    finally:
        mcp.p.terminate()


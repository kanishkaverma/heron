MARK = "@@heronctl@@"
REMOTE = r'''
import base64, datetime, glob, hashlib, json, os, platform, shutil, signal, subprocess, sys, time
HOME = os.path.expanduser("~")
H = os.path.join(HOME, ".heron")
os.environ["PATH"] = os.pathsep.join([os.path.join(HOME, ".local", "bin"), os.path.join(HOME, ".bun", "bin"),
                                      "/opt/homebrew/bin", "/usr/local/bin", os.environ.get("PATH", "")])
MAC = platform.system() == "Darwin"
UID = os.getuid()
LABELS = {"keeper": "com.kanishkaverma.heron-keeper", "syncthing": "com.kanishkaverma.heron-syncthing", "zeron": "sh.zeron.app"}
UNITS = {"keeper": "heron-keeper.service", "syncthing": "heron-syncthing.service", "zeron": "zeron.service"}
KILLED = os.path.join(H, "killed-by-heronctl.json")

def sh(*args, **kw):
    return subprocess.run(list(args), capture_output=True, text=True, timeout=kw.get("timeout", 30))

def read_json(path, default=None):
    try:
        return json.load(open(path))
    except Exception:
        return default

def write_json(path, value):
    tmp = path + ".tmp"
    json.dump(value, open(tmp, "w"), indent=2)
    os.replace(tmp, path)

def plist(name):
    return os.path.join(HOME, "Library", "LaunchAgents", LABELS[name] + ".plist")

def zeron_is_app():
    """On a Mac without the headless engine, Zeron is the desktop app."""
    return MAC and not os.path.exists(plist("zeron"))

def svc_running(name):
    if not MAC:
        return sh("systemctl", "--user", "is-active", UNITS[name]).stdout.strip() == "active"
    if name == "zeron" and zeron_is_app():
        return sh("pgrep", "-f", "Zeron.app/Contents/MacOS/").returncode == 0
    return "state = running" in sh("launchctl", "print", "gui/%d/%s" % (UID, LABELS[name])).stdout

def svc_stop(name):
    if not MAC:
        return sh("systemctl", "--user", "stop", UNITS[name]).returncode == 0
    if name == "zeron" and zeron_is_app():
        sh("osascript", "-e", 'quit app "Zeron"')
        return True
    sh("launchctl", "bootout", "gui/%d/%s" % (UID, LABELS[name]))
    return True

def svc_start(name):
    if not MAC:
        return sh("systemctl", "--user", "start", UNITS[name]).returncode == 0
    if name == "zeron" and zeron_is_app():
        return sh("open", "-ga", "Zeron").returncode == 0
    for _ in range(12):  # bootout returns before the job is gone; bootstrap too soon fails
        sh("launchctl", "bootstrap", "gui/%d" % UID, plist(name))
        if svc_running(name):
            return True
        time.sleep(1)
    return False

def svc_restart(name):
    if not MAC:
        return sh("systemctl", "--user", "restart", UNITS[name]).returncode == 0
    return sh("launchctl", "kickstart", "-k", "gui/%d/%s" % (UID, LABELS[name])).returncode == 0

def sha(path):
    try:
        return hashlib.sha256(open(path, "rb").read()).hexdigest()
    except Exception:
        return None

def log_tail(n=400):
    try:
        with open(os.path.join(H, "keeper.log"), "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 60000))
            return f.read().decode("utf8", "replace").splitlines()[-n:]
    except Exception:
        return []

def facts(dests):
    lines = log_tail()
    starts = [i for i, l in enumerate(lines) if "heron-keeper started" in l]
    errors = [l for l in lines[starts[-1] if starts else 0:] if " error:" in l or "unreachable" in l]
    def recent(line):  # the keeper logs decisions only, so an old error may be long over
        try:
            return (datetime.datetime.now() - datetime.datetime.strptime(line[:19], "%Y-%m-%d %H:%M:%S")).total_seconds() < 600
        except ValueError:
            return True
    errors = [l for l in errors if recent(l)]
    conflicts = []
    for root in ("memory", "threads", "shared"):
        conflicts += glob.glob(os.path.join(H, root, "**", "*sync-conflict*"), recursive=True)
    pi = sh("pi", "--version").stdout.strip().splitlines()
    skills = set()
    for d in (os.path.join(HOME, ".pi", "agent", "skills"), os.path.join(HOME, ".agents", "skills")):
        for p in glob.glob(os.path.join(d, "*")):
            skills.add(os.path.basename(p))
    runs = []
    for p in glob.glob(os.path.join(H, "runs", "*.json")):
        r = read_json(p, {})
        try:
            os.kill(r.get("pid") or -1, 0)
            runs.append(os.path.basename(p)[:-5])
        except Exception:
            pass
    st = os.statvfs(HOME)
    return {
        "hostname": platform.node(), "os": platform.system(),
        "services": {n: svc_running(n) for n in ("zeron", "keeper", "syncthing")},
        "pi": pi[-1] if pi else None, "skills": len(skills),
        "models": read_json(os.path.join(H, "models.json"), []),
        "keeper_config": read_json(os.path.join(H, "keeper.json"), {}),
        "killed": read_json(KILLED),
        "conflicts": sorted(os.path.relpath(c, H) for c in conflicts),
        "hashes": {d: sha(os.path.join(HOME, d)) for d in dests},
        "log_last": lines[-1] if lines else None,
        "log_last_error": errors[-1] if errors else None,
        "runs": runs,
        "disk_free_gb": round(st.f_bavail * st.f_frsize / 1e9, 1),
    }

def install(payload, restart, dry):
    changed = []
    for dest, (data, mode) in sorted(payload.items()):
        path = os.path.join(HOME, dest)
        new = base64.b64decode(data)
        if hashlib.sha256(new).hexdigest() == sha(path):
            continue
        changed.append(dest)
        if dry:
            continue
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if os.path.exists(path) and dest.endswith("AGENTS.md"):
            shutil.copy2(path, path + ".bak-" + time.strftime("%Y%m%d%H%M%S"))
        tmp = path + ".heronctl.tmp"
        open(tmp, "wb").write(new)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    restarted = False
    if changed and restart and not dry and any(d.startswith(".heron/heron-keeper") or d.startswith(".heron/pi_sync") for d in changed):
        restarted = svc_restart("keeper")
        time.sleep(3)
    return {"changed": changed, "restarted": restarted, "keeper": svc_running("keeper"),
            "log_last": (log_tail(1) or [None])[-1]}

def kill(hard, dry):
    names = ["zeron", "keeper", "syncthing"] if hard else ["zeron"]
    was = [n for n in names if svc_running(n)]
    if dry:
        return {"would_stop": was, "would_kill_runs": hard}
    prev = read_json(KILLED, {"stopped": []})
    write_json(KILLED, {"stopped": sorted(set(prev["stopped"]) | set(was)), "at": time.time(), "hard": hard})
    killed = 0
    if hard:  # first, and only the task runs this keeper started: their pids are in ~/.heron/runs
        svc_stop("keeper")  # or it restarts them
        for p in glob.glob(os.path.join(H, "runs", "*.json")):
            pid = (read_json(p, {}) or {}).get("pid")
            try:
                os.kill(pid, 0)
                killed += 1
                os.killpg(pid, signal.SIGKILL)
            except Exception:
                pass
    for n in was:
        svc_stop(n)
    time.sleep(1)
    return {"stopped": was, "runs_killed": killed, "still_running": [n for n in names if svc_running(n)]}

def revive(dry):
    marker = read_json(KILLED)
    if not marker:
        return {"started": [], "note": "nothing here was killed by heronctl"}
    order = [n for n in ("zeron", "syncthing", "keeper") if n in marker["stopped"]]
    if dry:
        return {"would_start": order}
    failed = [n for n in order if not svc_start(n)]
    time.sleep(2)
    down = [n for n in order if not svc_running(n)]
    if not down:
        os.remove(KILLED)
    return {"started": [n for n in order if n not in down], "failed": sorted(set(failed + down))}

def testmode(action, values):
    path = os.path.join(H, "keeper.json")
    saved = os.path.join(H, "keeper.json.before-test-mode")
    cfg = read_json(path, {}) or {}
    if action == "on":
        if not os.path.exists(saved):
            write_json(saved, cfg)
        cfg.update(values)
        write_json(path, cfg)
    elif action == "off" and os.path.exists(saved):
        before = read_json(saved, {}) or {}
        if before:
            write_json(path, before)
        elif os.path.exists(path):
            os.remove(path)
        os.remove(saved)
    return {"test_mode": os.path.exists(saved), "keeper_config": read_json(path, {}) or {}}


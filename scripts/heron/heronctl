def hosts(only=None):
    table = [dict(h) for h in HOSTS]
    try:
        for o in json.load(open(os.path.join(HOME, ".heron", "hosts.json"))):
            for h in table:
                if h["name"] == o.get("name"):
                    h.update(o)
                    break
            else:
                table.append(o)
    except FileNotFoundError:
        pass
    me = socket.gethostname().lower().split(".")[0]
    for h in table:
        h["local"] = me in [n.lower() for n in h.get("hostnames", [])]
    if only:
        want = [n.strip() for n in only.split(",") if n.strip()]
        unknown = set(want) - {h["name"] for h in table}
        if unknown:
            sys.exit("unknown computer: %s (known: %s)" % (", ".join(sorted(unknown)), ", ".join(h["name"] for h in table)))
        table = [h for h in table if h["name"] in want]
    return table


def ssh_target(host):
    """The ssh alias if ~/.ssh/config gives it a HostName, else user@tailscale-name."""
    if "target" not in host:
        alias = target = host["ssh"]
        if host.get("tailscale"):
            try:
                out = subprocess.run(["ssh", "-G", alias], capture_output=True, text=True, timeout=10).stdout
                hostname = next((l.split(None, 1)[1] for l in out.splitlines() if l.startswith("hostname ")), alias)
            except (OSError, subprocess.TimeoutExpired):
                hostname = alias
            if hostname.lower() == alias.lower():  # no alias here: ssh would look "zeph" up in DNS
                target = (host["user"] + "@" if host.get("user") else "") + host["tailscale"]
        host["target"] = target
    return host["target"]


TS_CHECK = "Tailscale SSH requires an additional check"


def ssh_cmd(host, *remote):
    # accept-new: a first visit by Tailscale name records its key instead of failing in batch mode.
    return ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", "-o", "StrictHostKeyChecking=accept-new",
            ssh_target(host)] + list(remote)


def remote(host, call, timeout=90):
    """Run REMOTE + `call` (Python source of one expression) on a computer.
    Returns the value, or raises RuntimeError with what went wrong."""
    script = REMOTE + "\nprint(%r + json.dumps(%s))\n" % (MARK, call)
    cmd = ["python3", "-"] if host["local"] else ssh_cmd(host, "python3 -")
    code, out, err = run(cmd, script, timeout)
    if TS_CHECK in err:  # it would wait for a browser login forever: give up at once
        raise RuntimeError("Tailscale SSH on %s wants a browser check: run `ssh %s true` and open the "
                           "login.tailscale.com link it prints" % (host["name"], ssh_target(host)))
    if code is None:
        raise RuntimeError("no answer in %ds" % timeout)
    for line in out.splitlines():
        if line.startswith(MARK):
            return json.loads(line[len(MARK):])
    err = (err.strip().splitlines() or ["exit %d" % code])[-1]
    raise RuntimeError(err[:300])


def run(cmd, data, timeout):
    """subprocess.run(cmd, input=data) that also stops early on a Tailscale SSH
    check prompt. Returns (exit code or None on timeout, stdout, stderr)."""
    import threading
    p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    out, err = [], []

    def feed():
        try:
            p.stdin.write(data)
            p.stdin.close()
        except (BrokenPipeError, OSError, ValueError):
            pass

    def pump(f, acc, watch):
        for line in f:
            acc.append(line)
            if watch and TS_CHECK in line:
                p.kill()
    readers = [threading.Thread(target=pump, args=(p.stdout, out, False), daemon=True),
               threading.Thread(target=pump, args=(p.stderr, err, True), daemon=True)]
    for t in [threading.Thread(target=feed, daemon=True)] + readers:
        t.start()
    try:
        code = p.wait(timeout)
    except subprocess.TimeoutExpired:
        p.kill()
        p.wait()
        code = None
    for t in readers:
        t.join(5)
    return code, "".join(out), "".join(err)


def each(table, call, timeout=90):
    """`call` on every computer at once -> {name: value or RuntimeError}."""
    def one(h):
        try:
            return remote(h, call(h) if callable(call) else call, timeout)
        except RuntimeError as e:
            return e
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        return dict(zip([h["name"] for h in table], pool.map(one, table)))


def lit(value):
    """A Python literal for the remote script, safe for any text."""
    return "json.loads(base64.b64decode(%r))" % base64.b64encode(json.dumps(value).encode()).decode()


def checkout():
    """This checkout's deployable files: {dest: (bytes, mode)}; and what's missing."""
    have, missing = {}, []
    for src, dest, mode in FILES:
        path = os.path.join(ROOT, src)
        if os.path.exists(path):
            have[dest] = (open(path, "rb").read(), mode)
        else:
            missing.append(src)
    return have, missing


def table_print(rows, header):
    widths = [max(len(str(r[i])) for r in [header] + rows) for i in range(len(header))]
    for r in [header] + rows:
        print("  ".join(str(c).ljust(w) for c, w in zip(r, widths)).rstrip())


def on(ok):
    return "up" if ok else "DOWN"


# ------------------------------------------------------------------ commands

def cmd_status(a):
    table = hosts(a.hosts)
    have, missing = checkout()
    dests = [d for _, d, _ in FILES]
    got = each(table, "facts(%s)" % lit(dests))
    rows, notes, bad = [], [], False
    for h in table:
        f = got[h["name"]]
        if isinstance(f, RuntimeError):
            rows.append([h["name"], "UNREACHABLE", "", "", "", "", "", "", ""])
            notes.append("%s: %s" % (h["name"], f))
            bad = True
            continue
        s = f["services"]
        differ = [d for d in have if hashlib.sha256(have[d][0]).hexdigest() != f["hashes"].get(d)]
        rows.append([h["name"], on(s["zeron"]), on(s["keeper"]), on(s["syncthing"]), f["pi"] or "?", f["skills"],
                     (f["models"] or ["none"])[0], "same" if not differ else "%d differ" % len(differ),
                     len(f["conflicts"]) or "-"])
        bad = bad or not all(s.values())
        if f["killed"]:
            notes.append("%s: taken down by `heronctl kill` (%s); `heronctl revive %s` brings it back"
                         % (h["name"], ", ".join(f["killed"]["stopped"]), h["name"]))
        if f["keeper_config"]:
            notes.append("%s: keeper.json overrides %s" % (h["name"], json.dumps(f["keeper_config"])))
        if len(f["models"]) < 2:
            notes.append("%s: only %d working model(s), so no fallback on a limit" % (h["name"], len(f["models"])))
        if f["conflicts"]:
            notes.append("%s: %d sync-conflict file(s), e.g. %s" % (h["name"], len(f["conflicts"]), f["conflicts"][0]))
        if f["log_last_error"]:
            notes.append("%s: last keeper error: %s" % (h["name"], f["log_last_error"][:160]))
        if f["runs"]:
            notes.append("%s: running task(s): %s" % (h["name"], ", ".join(f["runs"])))
        if f["disk_free_gb"] < 10:
            notes.append("%s: only %s GB free" % (h["name"], f["disk_free_gb"]))
    table_print(rows, ["computer", "zeron", "keeper", "sync", "pi", "skills", "model", "vs checkout", "conflicts"])
    cfgs = {json.dumps(f["keeper_config"], sort_keys=True) for f in got.values() if not isinstance(f, RuntimeError)}
    if len(cfgs) > 1:
        notes.append("keeper.json differs between computers: they will disagree about who is offline")
        bad = True
    for h in sorted(table, key=lambda h: not h["local"]):  # any computer whose Zeron answers
        try:
            w = remote(h, "chat('where', %s)" % lit(LIVE_CHAT), 40)
        except RuntimeError:
            continue
        c = w["chat"]
        print("\nHeron chat: on %s, %s, model %s, last message %s" % (w["host"], c["sessionStatus"], c["model"], c["lastMessageAt"])
              if c else "\nHeron chat: none")
        break
    else:
        notes.append("chat: no computer's Zeron answered")
        bad = True
    if missing:
        notes.append("not in this checkout (never deployed from here): %s" % ", ".join(missing))
    if notes:
        print("\n" + "\n".join("- " + n for n in notes))
    return 1 if bad else 0


def pick(table, name=None):
    """The computer to talk to Zeron on: the named one, this one, else the first."""
    if name:
        return hosts(name)[0]
    return next((h for h in table if h["local"]), table[0])


def cmd_diff(a):
    table = hosts(a.hosts)
    have, missing = checkout()
    got = each(table, "facts(%s)" % lit(list(have)))
    differs = False
    for h in table:
        f = got[h["name"]]
        if isinstance(f, RuntimeError):
            print("%s: UNREACHABLE (%s)" % (h["name"], f))
            differs = True
            continue
        d = [k for k in sorted(have) if hashlib.sha256(have[k][0]).hexdigest() != f["hashes"].get(k)]
        differs = differs or bool(d)
        print("%s: %s" % (h["name"], "same as this checkout" if not d else "differs: " + ", ".join("~/" + k for k in d)))
    for m in missing:
        print("not in this checkout, left alone everywhere: %s" % m)
    return 1 if differs else 0


def cmd_deploy(a):
    table = hosts(a.hosts)
    have, missing = checkout()
    payload = {d: [base64.b64encode(b).decode(), m] for d, (b, m) in have.items()}
    got = each(table, "install(%s, %r, %r)" % (lit(payload), not a.no_restart, a.dry_run), 120)
    failed = False
    for h in table:
        r = got[h["name"]]
        if isinstance(r, RuntimeError):
            print("%s: FAILED (%s)" % (h["name"], r))
            failed = True
            continue
        verb = "would change" if a.dry_run else "changed"
        print("%s: %s" % (h["name"], "already current" if not r["changed"] else "%s %s" % (verb, ", ".join("~/" + c for c in r["changed"]))))
        if not a.dry_run:
            if r["restarted"]:
                print("    keeper restarted: %s" % r["log_last"])
            if not r["keeper"]:
                print("    KEEPER IS NOT RUNNING")
                failed = True
    for m in missing:
        print("not in this checkout, left alone everywhere: %s" % m)
    if not a.dry_run and not failed:
        print("A running Heron chat keeps its old extension until its agent restarts.")
    return 1 if failed else 0


def tail_procs(table, n, follow):
    procs = []
    for h in table:
        args = ["tail", "-n", str(n)] + (["-F"] if follow else []) + [os.path.join(".heron", "keeper.log")]
        if h["local"]:
            args[-1] = os.path.join(HOME, args[-1])
            cmd = args
        else:
            cmd = ssh_cmd(h, " ".join(args))
        procs.append((h, subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                          text=True, bufsize=1)))
    return procs


def stream(procs, on_line):
    """Feed every line of every tail to on_line(host, line) until it returns True."""
    import queue
    import threading
    q = queue.Queue()

    def pump(h, p):
        for line in p.stdout:
            q.put((h, line.rstrip("\n")))
        q.put((h, None))
    for h, p in procs:
        threading.Thread(target=pump, args=(h, p), daemon=True).start()
    live = len(procs)
    try:
        while live:
            try:
                h, line = q.get(timeout=0.5)
            except queue.Empty:
                if on_line(None, None):
                    return True
                continue
            if line is None:
                live -= 1
            elif on_line(h, line):
                return True
    except KeyboardInterrupt:
        pass
    finally:
        for _, p in procs:
            p.terminate()
    return False


def cmd_logs(a):
    stream(tail_procs(hosts(a.hosts), a.n, a.follow), lambda h, l: print("%-5s %s" % (h["name"], l), flush=True) if h else None)
    return 0


def cmd_wait(a):
    """Until every regex has matched some keeper log line written from now on."""
    waiting = {r: re.compile(r) for r in a.regex}
    deadline, t0 = time.time() + a.timeout, time.time()

    def on_line(h, line):
        for r in [r for r, pattern in waiting.items() if h and pattern.search(line)]:
            del waiting[r]
            print("%-5s %s   (+%ds)" % (h["name"], line, time.time() - t0), flush=True)
        return not waiting or time.time() > deadline
    stream(tail_procs(hosts(a.hosts), 0, True), on_line)  # -n 0: only new lines
    for r in waiting:
        print("no keeper log line matched /%s/ in %ds" % (r, a.timeout))
    return 1 if waiting else 0


def cmd_tasks(a):
    table = hosts(a.hosts)
    rows = remote(pick(table), "tasks()")
    if not a.all:
        rows = [r for r in rows if not (r["state"] in ("done", "failed", "stopped") and r["notified"])]
    if not rows:
        print("no open tasks" + ("" if a.all else " (--all shows finished ones)"))
        return 0
    table_print([[r["id"], r["state"], r["owner"] or "-", r["attempt"] or "-", r["moved_from"] or "-",
                  "yes" if r["notified"] else "no", (r["title"] or "")[:40]] for r in rows],
                ["task", "state", "computer", "attempt", "moved from", "reported", "title"])
    return 0


def cmd_task(a):
    host = pick(hosts(a.hosts), a.on)
    if a.action == "start":
        if not (a.arg and a.brief):
            sys.exit('task start needs a title and a brief: heronctl task start "Title" "What to do"')
        r = remote(host, "task('start', title=%s, brief=%s)" % (lit(a.arg), lit(a.brief)))
        print(r["id"])
        return 0
    if not a.arg:
        sys.exit("task %s needs the task id (see `heronctl tasks`)" % a.action)
    r = remote(host, "task(%r, %s)" % (a.action, lit(a.arg)))
    if a.action != "show":
        print(json.dumps(r))
        return 0
    st, lease = r["status"], r["lease"]
    print("state %s, request %s, attempt %s on %s%s" % (st.get("state"), st.get("req"), lease.get("attempt"), lease.get("ownerName"),
                                                       ", moved from %s" % lease["movedFrom"] if lease.get("movedFrom") else ""))
    if st.get("error"):
        print("error: %s" % st["error"])
    for name in ("log", "result"):
        if r[name]:
            print("--- %s\n%s" % (name, r[name]))
    if r["work"]:
        print("--- work/: %s" % ", ".join(r["work"]))
    return 0


def cmd_chat(a):
    table = hosts(a.hosts)
    title = LIVE_CHAT if a.live else DEV_CHAT
    host = pick(table, a.on)
    if a.action == "where":
        w = remote(host, "chat('where', %s)" % lit(LIVE_CHAT), 40)
        print(json.dumps(w, indent=1, ensure_ascii=False))
        return 0
    if a.action == "cleanup":
        print(json.dumps(remote(host, "chat('cleanup', %s)" % lit(DEV_CHAT), 40)))
        return 0
    if a.action == "send":
        if not a.text:
            sys.exit("chat send needs the text")
        r = remote(host, "chat('send', %s, %s, %r, create=%r)" % (lit(title), lit(a.text), a.wait, not a.live), a.wait + 60)
    else:
        r = remote(host, "chat('read', %s, limit=%d)" % (lit(title), a.n), 40)
    print("[%s on %s%s]" % (title, r["host"], ", %ss" % r["secs"] if "secs" in r else ""))
    failed = False
    for m in r["messages"]:
        print("%s: %s" % (m["role"], m.get("text") or "(%s%s)" % (m.get("status", ""), ", tools: " + ", ".join(m["tools"]) if m.get("tools") else "")))
        if m.get("errors"):
            print("  ERRORS: %s" % " | ".join(m["errors"]))
            failed = True
    return 1 if failed else 0


def cmd_kill(a):
    h = hosts(a.host)[0]
    r = remote(h, "kill(%r, %r)" % (a.hard, a.dry_run), 60)
    print("%s: %s" % (h["name"], json.dumps(r)))
    if not a.dry_run:
        print("`heronctl revive %s` brings it back. The others notice it gone after the keeper's offline_secs." % h["name"])
    return 1 if r.get("still_running") else 0


def cmd_revive(a):
    table = hosts(",".join(a.host) if a.host else a.hosts)
    got = each(table, "revive(%r)" % a.dry_run, 90)
    failed = False
    for h in table:
        r = got[h["name"]]
        print("%s: %s" % (h["name"], r if isinstance(r, RuntimeError) else json.dumps(r)))
        failed = failed or isinstance(r, RuntimeError) or bool(r.get("failed"))
    return 1 if failed else 0


def cmd_test_mode(a):
    table = hosts(a.hosts)
    got = each(table, "testmode(%r, %s)" % (a.action, lit(TEST_MODE)), 40)
    states, failed = set(), False
    for h in table:
        r = got[h["name"]]
        if isinstance(r, RuntimeError):
            print("%s: UNREACHABLE (%s)" % (h["name"], r))
            failed = True
            continue
        states.add(r["test_mode"])
        print("%s: test mode %s  %s" % (h["name"], "ON" if r["test_mode"] else "off", json.dumps(r["keeper_config"]) if r["keeper_config"] else ""))
    if len(states) > 1 or (failed and a.action == "on"):
        print("NOT THE SAME EVERYWHERE: the computers will disagree about who is offline. Run `heronctl test-mode off`.")
        return 1
    if a.action == "on":
        print("Keepers pick this up on their next tick. Turn it off when done: `heronctl test-mode off`.")
    return 1 if failed else 0


def main():
    ap = argparse.ArgumentParser(prog="heronctl", description=__doc__.split("\n\n")[0],
                                 epilog="\n".join(__doc__.split("\n\n")[1:]), formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--hosts", help="only these computers, comma-separated (air,zeph,mbp)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    def add(name, fn, **kw):
        p = sub.add_parser(name, **kw)
        p.add_argument("--hosts", help=argparse.SUPPRESS, default=argparse.SUPPRESS)
        p.set_defaults(fn=fn)
        return p
    add("status", cmd_status)
    add("diff", cmd_diff)
    p = add("deploy", cmd_deploy)
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--no-restart", action="store_true")
    p = add("logs", cmd_logs)
    p.add_argument("-f", "--follow", action="store_true")
    p.add_argument("-n", type=int, default=15)
    p = add("wait", cmd_wait)
    p.add_argument("regex", nargs="+", help="every one must match (any order)")
    p.add_argument("--timeout", type=int, default=180)
    p = add("tasks", cmd_tasks)
    p.add_argument("--all", action="store_true")
    p = add("task", cmd_task)
    p.add_argument("action", choices=["start", "show", "stop", "rm"])
    p.add_argument("arg", nargs="?", help="start: the title; otherwise the task id")
    p.add_argument("brief", nargs="?")
    p.add_argument("--on", help="the computer to write the task on")
    p = add("chat", cmd_chat)
    p.add_argument("action", choices=["where", "read", "send", "cleanup"])
    p.add_argument("text", nargs="?")
    p.add_argument("--wait", type=int, default=0, help="seconds to wait for the reply")
    p.add_argument("--live", action="store_true", help="the real Heron chat, not the dev chat")
    p.add_argument("--on", help="the computer whose Zeron to talk to (and where a new dev chat is made)")
    p.add_argument("-n", type=int, default=6)
    p = add("kill", cmd_kill)
    p.add_argument("host")
    p.add_argument("--hard", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    p = add("revive", cmd_revive)
    p.add_argument("host", nargs="*")
    p.add_argument("--dry-run", action="store_true")
    p = add("test-mode", cmd_test_mode)
    p.add_argument("action", choices=["on", "off", "status"])
    a = ap.parse_args()
    try:
        sys.exit(a.fn(a))
    except RuntimeError as e:
        sys.exit("heronctl: %s" % e)
    except BrokenPipeError:
        pass


if __name__ == "__main__":
    main()
